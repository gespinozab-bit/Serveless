    "@aws-sdk/client-s3": "^3.1141.0",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.163",
    "@types/node": "^22.20.4",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
