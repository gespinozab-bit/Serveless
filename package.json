{
  "name": "s3-image-resizer",
  "version": "1.0.0",
  "private": true,
  "description": "Lambda para redimensionar imágenes JPEG y PNG de S3",
  "main": "dist/index.js",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
